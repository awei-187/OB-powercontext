# 比赛验收使用 dify；local 仅用于无外部服务的界面预览。
PROFILE_MODE=dify
PROFILE_HOST=127.0.0.1
PROFILE_PORT=8790
# PROFILE_DATA_DIR=/absolute/path

# 可选：仅供 DeepSeek 直连调试，不属于 Dify + PowerContext 验收。
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 导入并发布 workflow/personal-manual.yml 后创建该应用专用密钥。
DIFY_API_URL=http://127.0.0.1:8080/v1
DIFY_API_KEY=

# 比赛验收必须填写真实 PowerContext；故障或召回不全会阻止报告。
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_TOKEN=
