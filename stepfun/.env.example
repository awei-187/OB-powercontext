PORT=4317
# Docker Linux seekdb Server mode. Copy to .env and set a local-only password.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=12881
SEEKDB_USER=stepfun_app
SEEKDB_PASSWORD=replace_with_local_secret
SEEKDB_DATABASE=stepfun_lab

# Embedded mode is intentionally not the default on managed Windows hosts.
# Remove SEEKDB_HOST and use these only where the signed native addon is allowed:
# SEEKDB_PATH=.data/seekdb
# SEEKDB_BINDINGS_CACHE_DIR=.cache/bindings
