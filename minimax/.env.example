# Copy to .env locally; never commit credentials.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_DATABASE=minimax_sdd
SEEKDB_USER=minimax_app
SEEKDB_PASSWORD=
# Only needed when creating a separate database with compose.yaml.
# Existing database users do not need to set this.
SEEKDB_ROOT_PASSWORD=
# The workflow uses mmx's authenticated CN config, never sends keys in prompts.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_MODEL=
